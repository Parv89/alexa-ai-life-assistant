# Alexa AI Life Assistant - Backend Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection String (leave default for local MongoDB or provide MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/alexa_ai_assistant

# Optional AI Engine Key (System has full local deterministic AI processor built-in)
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Optional Amazon Alexa Skill Verification
ALEXA_SKILL_ID=amzn1.ask.skill.alexa-ai-life-assistant-demo
